# --- Flask Configuration ---
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=yoursecretkeyhere

# --- Database ---
# SQLite default: sqlite:///instance/textile.db
# PostgreSQL: postgresql://postgres:postgres@db:5432/textile_db
DATABASE_URL=sqlite:///instance/textile.db

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- Production Tuning ---
WEB_CONCURRENCY=4
