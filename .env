# --- Flask Configuration ---
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=yoursecretkeyhere

# --- Database ---
# Using PostgreSQL instance setup by docker-compose
DATABASE_URL=postgresql://postgres:postgres@db:5432/textile_db

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- Production Tuning ---
WEB_CONCURRENCY=4
