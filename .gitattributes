# Balanced Full-Stack Display Attribute
# Showing all used languages while dampening the outliers

# Exclude only huge files that overwhelm the stats
templates/admin/index.html linguist-documentation
templates/public/index.html linguist-documentation
static/css/admin_dashboard.css linguist-documentation

# Exclude non-code
docs/** linguist-documentation
instance/** linguist-documentation
app_backup.py linguist-documentation
*.md linguist-documentation

# Mark migrations as generated
migrations/** linguist-generated

# Now all other HTML, CSS, and JS files across the project 
# will be counted as code, keeping every language visible.
